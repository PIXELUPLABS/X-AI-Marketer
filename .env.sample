# PIXELUP — X AI Employee (weekly worksnap pipeline)
# Copy to .env and fill. Never commit .env.
# Missing keys are fine: the pipeline auto-falls back to dry-run and says so loudly.

# --- Figma ---
# Personal access token, READ-ONLY scopes: files:read, file_content:read.
# Nothing is ever written back to the file.
# Create at https://www.figma.com/developers/api#access-tokens
FIGMA_PAT=

# --- Typefully ---
# Settings -> API in the Typefully workspace that owns the persona's X account.
# The pipeline only ever creates PLANNED drafts (inert until confirmed in the app),
# uploads media, and lists social sets. It never publishes directly.
TYPEFULLY_API_KEY=

# --- Claude (captions + orchestration run inside Claude Code) ---
# Only needed if a script ever calls the API directly; the weekly run itself
# is driven by a Claude Code session, which brings its own auth.
ANTHROPIC_API_KEY=
